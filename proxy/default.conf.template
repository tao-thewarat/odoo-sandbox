# Rendered by the nginx image's envsubst: ${SANDBOX_DOMAIN} comes
# from docker-compose; nginx's own $variables are left untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keep https when TLS terminates in front of this proxy.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    return 404;
}

# UI (static build, production only) and API.
server {
    listen 80;
    server_name ${SANDBOX_DOMAIN};
    root /usr/share/nginx/html;

    location / {
        try_files $uri /index.html;
    }

    location ~ ^/(api|auth|health)(/|$) {
        client_max_body_size 0;
        proxy_request_buffering off;
        set $api http://api:8000;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 720s;
    }
}

# Sandboxes: <32-hex job id>.<domain> -> that lab's Odoo container.
server {
    listen 80;
    server_name "~^(?<lab>[0-9a-f]{32})\.";
    client_max_body_size 100m;

    location / {
        proxy_pass http://lab-$lab:8069;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 720s;
    }
}
